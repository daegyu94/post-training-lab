{
  "setup": "spark",
  "master_addr": "spark1",
  "master_port": 29670,
  "env": {
    "NCCL_DEBUG": "WARN",
    "OMP_NUM_THREADS": "4"
  },
  "nodes": [
    {
      "host": "spark1",
      "checkout": "/path/to/shared/post-training-lab",
      "python": {
        "trl": "/path/to/ptl/venvs/trl/bin/python",
        "megatron": "/path/to/ptl/venvs/megatron/bin/python"
      },
      "env": {},
      "model_dirs": {
        "Qwen/Qwen2.5-0.5B-Instruct": "/path/to/Qwen2.5-0.5B-Instruct",
        "Qwen/Qwen3-30B-A3B": "/path/to/Qwen3-30B-A3B",
        "zai-org/GLM-4.7-Flash": "/path/to/GLM-4.7-Flash"
      },
      "data_dir": "/path/to/ptl/data/prepared-data",
      "output_root": {
        "trl": "/path/to/trl-run-results",
        "megatron": "/path/to/megatron-run-results"
      }
    },
    {
      "host": "spark2",
      "checkout": "/path/to/shared/post-training-lab",
      "python": {
        "trl": "/path/to/ptl/venvs/trl/bin/python",
        "megatron": "/path/to/ptl/venvs/megatron/bin/python"
      },
      "env": {},
      "model_dirs": {
        "Qwen/Qwen2.5-0.5B-Instruct": "/path/to/Qwen2.5-0.5B-Instruct",
        "Qwen/Qwen3-30B-A3B": "/path/to/Qwen3-30B-A3B",
        "zai-org/GLM-4.7-Flash": "/path/to/GLM-4.7-Flash"
      },
      "data_dir": "/path/to/ptl/data/prepared-data",
      "output_root": {
        "trl": "/path/to/trl-run-results",
        "megatron": "/path/to/megatron-run-results"
      }
    }
  ]
}
