{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daegyu94/sft-lab/blob/profiling/config/metrics.schema.json",
  "title": "SFT Lab profiling metric contract",
  "type": "object",
  "required": [
    "schema_version",
    "recommended_labels",
    "manifest_only_fields",
    "phase_vocabulary",
    "metrics"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "recommended_labels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "manifest_only_fields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "phase_vocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "unit",
          "scope",
          "source",
          "policy"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "category": {
            "enum": [
              "training",
              "rollout",
              "agent",
              "orchestration",
              "gpu",
              "host",
              "container",
              "network",
              "data_movement",
              "storage",
              "checkpoint"
            ]
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "additionalProperties": false
}
