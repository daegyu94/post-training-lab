[global]
ioengine=${FIO_IOENGINE}
direct=1
group_reporting=1
time_based=1
runtime=${FIO_RUNTIME}
directory=${FIO_DIRECTORY}
size=${FIO_SIZE}

[checkpoint-write]
rw=write
bs=4M
iodepth=16
filename=profiling-lab-checkpoint.bin

[checkpoint-read]
stonewall
rw=read
bs=4M
iodepth=16
filename=profiling-lab-checkpoint.bin
