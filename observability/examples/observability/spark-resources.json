    {"id": 5, "type": "table", "title": "GPU utilization matrix (latest sample)", "description": "Rows are Spark nodes and columns are GPUs currently reported by the sampler. Missing cells are not allocation information.", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 5}, "datasource": {"type": "prometheus", "uid": "spark-prometheus"}, "targets": [{"refId": "A", "expr": "last_over_time(profiling_gpu_utilization_percent{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\"}[5m])", "format": "table", "instant": true}], "fieldConfig": {"defaults": {"unit": "percent", "noValue": "N/A", "custom": {"cellOptions": {"type": "color-background"}}}, "overrides": []}, "options": {"showHeader": true, "footer": {"show": false}}, "transformations": [{"id": "groupingToMatrix", "options": {"columnField": "gpu", "rowField": "instance", "valueField": "Value"}}]},
