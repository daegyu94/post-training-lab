        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU SM clock",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "profiling_gpu_sm_clock_mhz{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mhz",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Compute-process GPU memory",
      "description": "nvidia-smi compute-process memory; it is not total unified-memory use.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "profiling_gpu_process_memory_bytes{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "{{instance}} PID {{pid}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Rank-local framework timers",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "training_timer_seconds{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"}",
          "legendFormat": "{{framework}} rank {{rank}} {{timer}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "TCP/Ethernet throughput by interface",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, device) (rate(node_network_receive_bytes_total{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",device!~\"lo|docker.*|veth.*\"}[1m]))",
          "legendFormat": "{{instance}} {{device}} RX"
        },
        {
          "refId": "B",
          "expr": "sum by (instance, device) (rate(node_network_transmit_bytes_total{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",device!~\"lo|docker.*|veth.*\"}[1m]))",
          "legendFormat": "{{instance}} {{device}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RDMA throughput by port",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance, device, port) (rate(node_infiniband_port_data_received_bytes_total{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\"}[1m]))",
          "legendFormat": "{{instance}} {{device}}/{{port}} RX"
        },
        {
          "refId": "B",
          "expr": "sum by (instance, device, port) (rate(node_infiniband_port_data_transmitted_bytes_total{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\"}[1m]))",
          "legendFormat": "{{instance}} {{device}}/{{port}} TX"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "text",
      "title": "Allocation and interconnect evidence",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "options": {
        "mode": "markdown",
        "content": "The sampler reports GPU index and utilization, and framework snapshots report rank and local rank, but neither carries a UUID-based run-to-GPU allocation mapping. Allocation is therefore not inferred from utilization. TCP/RDMA panels are port counters, not node-to-node or GPU-to-GPU traffic. Add an interconnect matrix only after topology and endpoint-pair measurements are collected."
      }
    }
  ],
