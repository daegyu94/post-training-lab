{
  "annotations": {
    "list": []
  },
  "editable": true,
  "links": [
    {
      "includeTimeRange": true,
      "keepTime": true,
      "title": "Run Overview",
      "type": "link",
      "url": "/d/spark-profiling?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "GPU utilization matrix (latest sample)",
      "description": "Rows are nodes and columns are currently reported GPU indexes. This is utilization, not run allocation.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((profiling_gpu_utilization_percent{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\"} and on(cluster, instance) (time() - profiling_gpu_sample_timestamp_seconds{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\"} < 5)), \"node\", \"/\", \"cluster\", \"instance\")",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "gpu",
            "rowField": "node",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "GPU utilization",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "profiling_gpu_utilization_percent{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "GPU power",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "profiling_gpu_power_watts{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "GPU temperature",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "profiling_gpu_temperature_celsius{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "{{instance}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "N/A"
        },
        "overrides": []
