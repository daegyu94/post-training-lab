{
  "annotations": {
    "list": []
  },
  "editable": true,
  "links": [
    {
      "includeTimeRange": true,
      "keepTime": true,
      "title": "Compute & Communication",
      "type": "link",
      "url": "/d/post-training-compute-communication?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    },
    {
      "includeTimeRange": true,
      "keepTime": true,
      "title": "Data & Storage",
      "type": "link",
      "url": "/d/post-training-data-storage?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter targets up",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "observability-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Host available memory by node",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "observability-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Training sample age by rank",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "observability-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - training_sample_timestamp_seconds{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"}",
          "instant": true,
          "legendFormat": "{{cluster}}/{{instance}} {{run_id}} {{framework}} rank {{rank}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      },
      "description": "Age of each selected rank snapshot, including stale ones. A fresh rank must not hide a stalled rank; age alone does not prove whether a process is alive."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "GPU sample age by node",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "observability-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance) (time() - profiling_gpu_sample_timestamp_seconds{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "GPU utilization matrix (latest sample)",
      "description": "Rows: cluster/node; columns: reported GPU index. Samples older than 30 seconds are hidden. 0% means measured idle; N/A means missing evidence, not an unallocated GPU. Host-wide, independent of the Run filter.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "observability-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join((profiling_gpu_utilization_percent{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\"} and on(cluster, instance) (time() - profiling_gpu_sample_timestamp_seconds{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\"} < 30)), \"node\", \"/\", \"cluster\", \"instance\")",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "custom": {
            "cellOptions": {
              "type": "color-background"
            }
          },
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "gpu",
            "rowField": "node",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Training throughput (tokens/s)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "observability-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(training_tokens_per_second{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"}) and on(cluster, instance, run_id, framework, node, rank, local_rank) (time() - training_sample_timestamp_seconds{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"} < $training_max_age)",
          "legendFormat": "{{cluster}}/{{instance}} {{run_id}} {{framework}} rank {{rank}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": " Samples beyond Training sample max age are hidden; increase it for long steps. Throughput is per-rank reporting, not a sum across ranks."
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Training step time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "observability-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(training_step_time_seconds{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"}) and on(cluster, instance, run_id, framework, node, rank, local_rank) (time() - training_sample_timestamp_seconds{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"} < $training_max_age)",
          "legendFormat": "{{cluster}}/{{instance}} {{run_id}} {{framework}} rank {{rank}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": " Samples beyond Training sample max age are hidden; increase it for long steps. Throughput is per-rank reporting, not a sum across ranks."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Training loss",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "observability-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(training_loss{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"}) and on(cluster, instance, run_id, framework, node, rank, local_rank) (time() - training_sample_timestamp_seconds{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\",run_id=~\"$run_id\"} < $training_max_age)",
          "legendFormat": "{{cluster}}/{{instance}} {{run_id}} {{framework}} rank {{rank}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "description": " Samples beyond Training sample max age are hidden; increase it for long steps. Throughput is per-rank reporting, not a sum across ranks."
    },
    {
      "id": 9,
      "type": "text",
      "title": "Interpretation",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "options": {
        "mode": "markdown",
        "content": "This overview relates a run to the selected nodes and time range; host and GPU metrics are **not** run-exclusive until allocation mapping is collected. GPU utilization of 0% is measured idle, while a missing cell is not a claim of no allocation. on systems with unified host/GPU memory, host memory and GPU allocation are not additive; unavailable GPU-memory values stay N/A."
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Host swap used by node",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "observability-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_SwapTotal_bytes{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\"} - node_memory_SwapFree_bytes{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\"}",
          "legendFormat": "{{cluster}}/{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Host swap I/O pages per second",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "observability-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_vmstat_pswpin{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\"}[$__rate_interval]) + rate(node_vmstat_pswpout{job=\"observability\",cluster=~\"$cluster\",instance=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "post-training",
    "overview",
    "observability"
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "observability-prometheus"
        },
        "definition": "label_values(up{job=\"observability\"}, cluster)",
        "query": "label_values(up{job=\"observability\"}, cluster)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "refresh": 2
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "observability-prometheus"
        },
        "definition": "label_values(up{job=\"observability\", cluster=~\"$cluster\"}, instance)",
        "query": "label_values(up{job=\"observability\", cluster=~\"$cluster\"}, instance)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "refresh": 2
      },
      {
        "name": "run_id",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "observability-prometheus"
        },
        "definition": "label_values(training_step{job=\"observability\", cluster=~\"$cluster\", instance=~\"$node\"}, run_id)",
        "query": "label_values(training_step{job=\"observability\", cluster=~\"$cluster\", instance=~\"$node\"}, run_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "refresh": 2
      },
      {
        "name": "training_max_age",
        "label": "Training sample max age (s)",
        "type": "custom",
        "query": "30,60,300,900,3600",
        "current": {
          "text": "300",
          "value": "300"
        },
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Post-Training Run Overview",
  "uid": "observability-overview",
  "version": 2
}
