{
  "annotations": {
    "list": []
  },
  "editable": true,
  "links": [
    {
      "includeTimeRange": true,
      "keepTime": true,
      "title": "Run Overview",
      "type": "link",
      "url": "/d/observability-overview?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    }
  ],
  "panels": [
    {
      "datasource": {
        "type": "loki",
        "uid": "observability-loki"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{cluster=~\"$cluster\", node=~\"$node\", workload=~\"$workload\"} | unpack | run_id=~\"$run_id\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Node-local run logs",
      "type": "logs"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": [
    "logs",
    "observability",
    "post-training"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "observability-loki"
        },
        "definition": "label_values(cluster)",
        "includeAll": true,
        "label": "Cluster",
        "multi": true,
        "name": "cluster",
        "query": "label_values(cluster)",
        "refresh": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "observability-loki"
        },
        "definition": "label_values({cluster=~\"$cluster\"}, node)",
        "includeAll": true,
        "label": "Node",
        "multi": true,
        "name": "node",
        "query": "label_values({cluster=~\"$cluster\"}, node)",
        "refresh": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "loki",
          "uid": "observability-loki"
        },
        "definition": "label_values({cluster=~\"$cluster\", node=~\"$node\"}, workload)",
        "includeAll": true,
        "label": "Workload",
        "multi": true,
        "name": "workload",
        "query": "label_values({cluster=~\"$cluster\", node=~\"$node\"}, workload)",
        "refresh": 2,
        "type": "query"
      },
      {
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "label": "Run",
        "name": "run_id",
        "query": ".*",
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Post-Training Run Logs",
  "uid": "post-training-run-logs",
  "version": 1
}
