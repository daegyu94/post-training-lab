{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU busy by node (%)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Host memory used by node (%)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "{{instance}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "GPU utilization (%)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "DCGM_FI_DEV_GPU_UTIL", "legendFormat": "{{instance}} GPU {{gpu}}"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "GPU framebuffer used",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "DCGM_FI_DEV_FB_USED * 1024 * 1024", "legendFormat": "{{instance}} GPU {{gpu}}"}],
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "TCP/Ethernet network throughput",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "targets": [
        {"expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*\"}[1m]))", "legendFormat": "{{instance}} RX"},
        {"expr": "sum by (instance) (rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*\"}[1m]))", "legendFormat": "{{instance}} TX"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "RDMA (InfiniBand/RoCE) throughput",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "targets": [
        {"expr": "sum by (instance) (rate(node_infiniband_port_data_received_bytes_total[1m]))", "legendFormat": "{{instance}} RX"},
        {"expr": "sum by (instance) (rate(node_infiniband_port_data_transmitted_bytes_total[1m]))", "legendFormat": "{{instance}} TX"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Disk I/O busy time",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "targets": [{"expr": "rate(node_disk_io_time_seconds_total[1m])", "legendFormat": "{{instance}} {{device}}"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0}, "overrides": []}
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["llm", "profiling", "multinode"],
  "templating": {"list": []},
  "time": {"from": "now-30m", "to": "now"},
  "timezone": "browser",
  "title": "Multinode LLM Cluster Resources",
  "uid": "llm-cluster-resources",
  "version": 1
}
