{
  "annotations": {
    "list": []
  },
  "editable": true,
  "links": [
    {
      "includeTimeRange": true,
      "keepTime": true,
      "title": "Run Overview",
      "type": "link",
      "url": "/d/spark-profiling?${cluster:queryparam}&${node:queryparam}&${run_id:queryparam}"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Disk read and write throughput",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}} {{device}} read"
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_written_bytes_total{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}} {{device}} write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Disk IOPS",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_reads_completed_total{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}} {{device}} read"
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_writes_completed_total{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}} {{device}} write"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "iops",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk I/O busy time",
      "description": "Fraction of wall time with I/O in progress. This is not a latency percentile.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_io_time_seconds_total{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",device=~\"$device\"}[$__rate_interval])",
          "legendFormat": "{{cluster}}/{{instance}} {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Filesystem used",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",mountpoint=~\"$mount\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",mountpoint=~\"$mount\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{cluster}}/{{instance}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Filesystem free space",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_filesystem_avail_bytes{job=\"spark\",cluster=~\"$cluster\",instance=~\"$node\",mountpoint=~\"$mount\",fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{cluster}}/{{instance}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "text",
      "title": "Data path and storage topology",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "options": {
        "mode": "markdown",
        "content": "These are client-node local device and filesystem counters. They can be correlated with a run's time range, but are not attributed to a dataset, checkpoint, trajectory, replay store, or tool call without workload instrumentation. This dashboard does not assume NFS. A future 3FS, pNFS, or other remote-storage topology requires supplied component and edge IDs plus matching service metrics; metadata and data roles may share a server or be separate."
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Storage topology components",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster, kind, component, role) (profiling_topology_component_info{job=\"spark\",cluster=~\"$cluster\",kind=\"storage\"})",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "Supplied components for the selected clusters. Independent of Node and Run filters."
    },
    {
      "id": 8,
      "type": "table",
      "title": "Storage topology matrix",
      "description": "Cluster-filtered supplied edges, not measured traffic. Cluster-qualified endpoints prevent collisions. Node and Run filters do not restrict topology: its publisher may be a different node.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_join(label_join(max by (cluster, source, destination) (profiling_topology_edge_info{job=\"spark\",cluster=~\"$cluster\",kind=\"storage\"}), \"source_key\", \"/\", \"cluster\", \"source\"), \"destination_key\", \"/\", \"cluster\", \"destination\")",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "destination_key",
            "rowField": "source_key",
            "valueField": "Value"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "SSDs with critical warnings",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(smartctl_device_critical_warning{job=\"storage-smart\",cluster=~\"$cluster\",storage_system=~\"$storage_system\",instance=~\"$storage_node\",device=~\"$ssd\"} != 0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Number of selected SSDs whose NVMe critical-warning bitmask is non-zero."
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Maximum SSD temperature",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(smartctl_device_temperature{job=\"storage-smart\",cluster=~\"$cluster\",storage_system=~\"$storage_system\",instance=~\"$storage_node\",device=~\"$ssd\",temperature_type=\"current\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Maximum endurance used",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(smartctl_device_percentage_used{job=\"storage-smart\",cluster=~\"$cluster\",storage_system=~\"$storage_system\",instance=~\"$storage_node\",device=~\"$ssd\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "description": "Vendor-estimated NVMe endurance consumed. It is coarse and may update only once per power-on hour."
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Minimum available spare",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(smartctl_device_available_spare{job=\"storage-smart\",cluster=~\"$cluster\",storage_system=~\"$storage_system\",instance=~\"$storage_node\",device=~\"$ssd\"})",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "green",
                "value": 20
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
