    {
      "id": 16,
      "type": "bargauge",
      "title": "Lifetime host bytes written by SSD",
      "description": "Host writes reported by the device. This does not include internal NAND writes from garbage collection or wear leveling.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_bytes_written{job=\"storage-smart\",cluster=~\"$cluster\",storage_system=~\"$storage_system\",instance=~\"$storage_node\",device=~\"$ssd\"}",
          "legendFormat": "{{storage_system}}/{{instance}} {{device}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
