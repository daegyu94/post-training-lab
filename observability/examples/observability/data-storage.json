    {
      "id": 17,
      "type": "table",
      "title": "SSD inventory and SMART status",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (cluster, storage_system, instance, device, protocol, model_name, firmware_version) (smartctl_device{job=\"storage-smart\",cluster=~\"$cluster\",storage_system=~\"$storage_system\",instance=~\"$storage_node\",device=~\"$ssd\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "smartctl_device_smart_status{job=\"storage-smart\",cluster=~\"$cluster\",storage_system=~\"$storage_system\",instance=~\"$storage_node\",device=~\"$ssd\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "smartctl_device_smartctl_exit_status{job=\"storage-smart\",cluster=~\"$cluster\",storage_system=~\"$storage_system\",instance=~\"$storage_node\",device=~\"$ssd\"}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "N/A"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "description": "Device identity omits the serial-number label. SMART status 1 means passed; smartctl exit status 0 means collection succeeded."
    }
