    {
      "id": 15,
      "type": "timeseries",
      "title": "NVMe media errors",
      "description": "Lifetime unrecovered media-error counters. Any increase requires investigation.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "spark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "smartctl_device_media_errors{job=\"storage-smart\",cluster=~\"$cluster\",storage_system=~\"$storage_system\",instance=~\"$storage_node\",device=~\"$ssd\"}",
          "legendFormat": "{{storage_system}}/{{instance}} {{device}}"
