{
  "backend": "megatron",
  "setup": "spark",
  "base_experiment": "experiments/megatron/qwen3-30b-lora.json",
  "defaults": {
    "steps": 4,
    "repeats": 3,
    "within_run_warmup": 1,
    "checkpoint_intervals": [4, 4]
  },
  "common_env": {
    "MODEL_ID": "Qwen/Qwen3-30B-A3B",
    "MODEL_REVISION": "ad44e777bcd18fa416d9da3bd8f70d33ebb85d39",
    "DATASET_ID": "HuggingFaceH4/ultrachat_200k",
    "DATASET_REVISION": "8049631c405ae6576f93f445c6b8166f76f5505a",
    "FINETUNING_MODE": "lora",
    "GLOBAL_BATCH_SIZE": 2,
    "MICRO_BATCH_SIZE": 1,
    "TP": 1,
    "PP": 1,
    "EP": 2,
    "MAX_LENGTH": 2048,
    "PAD_TO_MAX_LENGTH": true,
    "TRANSFORMER_IMPL": "transformer_engine",
    "SAVE_INTERVAL": 4,
    "SAVE_OPTIMIZER": false,
    "CHECKPOINT_PLACEMENT": "local",
    "RESOURCE_SAMPLING": true,
    "MEASURE_TIMING": true,
    "SEED": 42,
    "STAGE": "train"
  },
  "cells": [
    {
      "name": "recompute-length-2048",
      "varying": ["RECOMPUTE"],
      "variants": [
        {"name": "full", "env": {"MAX_LENGTH": 2048, "RECOMPUTE": "full"}},
        {"name": "selective", "env": {"MAX_LENGTH": 2048, "RECOMPUTE": "selective"}}
      ]
    },
    {
      "name": "recompute-length-4096",
      "varying": ["RECOMPUTE"],
      "variants": [
        {"name": "full", "env": {"MAX_LENGTH": 4096, "RECOMPUTE": "full"}},
        {"name": "selective", "env": {"MAX_LENGTH": 4096, "RECOMPUTE": "selective"}}
      ]
    }
  ]
}
