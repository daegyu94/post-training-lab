{
  "backend": "megatron",
  "setup": "spark",
  "base_experiment": "experiments/megatron/smoke.json",
  "defaults": {
    "steps": 64,
    "repeats": 4,
    "within_run_warmup": 8,
    "checkpoint_intervals": [16, 32]
  },
  "common_env": {
    "MODEL_ID": "Qwen/Qwen2.5-0.5B-Instruct",
    "MODEL_REVISION": "7ae557604adf67be50417f59c2c2f167def9a775",
    "DATASET_ID": "HuggingFaceH4/no_robots",
    "DATASET_REVISION": "e6f9a4ac5c37faeb744ba9ecf0473184d7f8105b",
    "FINETUNING_MODE": "full",
    "GLOBAL_BATCH_SIZE": 4,
    "MICRO_BATCH_SIZE": 1,
    "TP": 1,
    "PP": 1,
    "EP": 1,
    "MAX_LENGTH": 2048,
    "SEED": 42,
    "STAGE": "train",
    "MEASURE_TIMING": true
  },
  "cells": [
    {"name": "overlap-mbs-1", "varying": ["OVERLAP_GRAD_REDUCE"], "variants": [
      {"name": "off", "env": {"MICRO_BATCH_SIZE": 1, "OVERLAP_GRAD_REDUCE": false}},
      {"name": "on", "env": {"MICRO_BATCH_SIZE": 1, "OVERLAP_GRAD_REDUCE": true}}
    ]},
    {"name": "overlap-mbs-2", "varying": ["OVERLAP_GRAD_REDUCE"], "variants": [
      {"name": "off", "env": {"MICRO_BATCH_SIZE": 2, "OVERLAP_GRAD_REDUCE": false}},
      {"name": "on", "env": {"MICRO_BATCH_SIZE": 2, "OVERLAP_GRAD_REDUCE": true}}
    ]},
    {"name": "recompute-length-2048", "varying": ["RECOMPUTE"], "variants": [
      {"name": "full", "env": {"MAX_LENGTH": 2048, "RECOMPUTE": "full"}},
      {"name": "selective", "env": {"MAX_LENGTH": 2048, "RECOMPUTE": "selective"}}
    ]},
    {"name": "recompute-length-4096", "varying": ["RECOMPUTE"], "variants": [
      {"name": "full", "env": {"MAX_LENGTH": 4096, "RECOMPUTE": "full"}},
      {"name": "selective", "env": {"MAX_LENGTH": 4096, "RECOMPUTE": "selective"}}
    ]},
    {"name": "sequence-parallel-length-2048", "varying": ["SEQUENCE_PARALLEL"], "variants": [
      {"name": "off", "env": {"MAX_LENGTH": 2048, "SEQUENCE_PARALLEL": false, "TP": 2, "TRANSFORMER_IMPL": "transformer_engine"}},
      {"name": "on", "env": {"MAX_LENGTH": 2048, "SEQUENCE_PARALLEL": true, "TP": 2, "TRANSFORMER_IMPL": "transformer_engine"}}
    ]},
    {"name": "sequence-parallel-length-4096", "varying": ["SEQUENCE_PARALLEL"], "variants": [
      {"name": "off", "env": {"MAX_LENGTH": 4096, "SEQUENCE_PARALLEL": false, "TP": 2, "TRANSFORMER_IMPL": "transformer_engine"}},
      {"name": "on", "env": {"MAX_LENGTH": 4096, "SEQUENCE_PARALLEL": true, "TP": 2, "TRANSFORMER_IMPL": "transformer_engine"}}
    ]},
    {"name": "checkpoint-interval-16", "varying": ["CHECKPOINT_MODE"], "variants": [
      {"name": "sync", "env": {"SAVE_INTERVAL": 16, "CHECKPOINT_MODE": "sync"}},
      {"name": "async", "env": {"SAVE_INTERVAL": 16, "CHECKPOINT_MODE": "async"}}
    ]},
    {"name": "checkpoint-interval-32", "varying": ["CHECKPOINT_MODE"], "variants": [
      {"name": "sync", "env": {"SAVE_INTERVAL": 32, "CHECKPOINT_MODE": "sync"}},
      {"name": "async", "env": {"SAVE_INTERVAL": 32, "CHECKPOINT_MODE": "async"}}
    ]}
  ]
}
